Color :: struct { r: u8, g: u8, b: u8, a: u8 };
InitWindow : (i32, i32, cstr) -> () : extern "C";
WindowShouldClose : () -> bool : extern "C";
SetTargetFPS : (i32) -> () : extern "C";
BeginDrawing : () -> () : extern "C";
ClearBackground : (Color) -> () : extern "C";
DrawText : (cstr, i32, i32, i32, Color) -> () : extern "C";
EndDrawing : () -> () : extern "C";
CloseWindow : () -> () : extern "C";
// x, y, w, h
DrawRectangleLines : (i32, i32, i32, i32, Color) -> () : extern "C";
DrawLine : (i32, i32, i32, i32, Color) -> () : extern "C";

main :: fn -> i32 {
  window_width := 1280;
  window_height := 720;

  header_height := 50;
  bottom_height := 100;
  left_width := 500;

  arena_x := left_width;
  arena_y := header_height;
  arena_width := window_width - left_width;
  arena_height := window_height - header_height - bottom_height;
  bottom_y := arena_y + arena_height;

  background_color := Color.{r = 248, g = 248, b = 245, a = 255};
  border_color := Color.{r = 0, g = 0, b = 0, a = 255};

  grid_columns := 12;
  grid_rows := 9;

  InitWindow(window_width, window_height, "BitBrawler");
  SetTargetFPS(60);

  while !WindowShouldClose() {
    BeginDrawing();
    ClearBackground(background_color);

    // editor
    DrawRectangleLines(0, header_height, left_width, arena_height, border_color);

    // arena
    DrawRectangleLines(arena_x, arena_y, arena_width, arena_height, border_color);

    // arena grid
    for column := 1..grid_columns {
      line_x := arena_x + arena_width * column / grid_columns;
      DrawLine(line_x, arena_y, line_x, arena_y + arena_height, border_color)
    };

    for row:= 1..grid_rows {
      line_y := arena_y + arena_height * row / grid_rows;
      DrawLine(arena_x, line_y, arena_x + arena_width, line_y, border_color)
    };

    // bot status
    DrawRectangleLines(0, bottom_y, left_width, bottom_height, border_color);

    // logs
    DrawRectangleLines(arena_x, bottom_y, arena_width, bottom_height, border_color);

    EndDrawing()
  };

  CloseWindow();
  return 0
};
