Color :: struct { r: u8, g: u8, b: u8, a: u8 };
InitWindow : (i32, i32, cstr) -> () : extern "C";
WindowShouldClose : () -> bool : extern "C";
SetTargetFPS : (i32) -> () : extern "C";
BeginDrawing : () -> () : extern "C";
ClearBackground : (Color) -> () : extern "C";
DrawText : (cstr, i32, i32, i32, Color) -> () : extern "C";
EndDrawing : () -> () : extern "C";
CloseWindow : () -> () : extern "C";
// x, y, w, h
DrawRectangleLines : (i32, i32, i32, i32, Color) -> () : extern "C";
DrawLine : (i32, i32, i32, i32, Color) -> () : extern "C";
DrawRectangle : (i32, i32, i32, i32, Color) -> () : extern "C";
MeasureText : (cstr, i32) -> i32 : extern "C";

main :: fn -> i32 {
  window_width := 1280;
  window_height := 720;

  header_height := 50;
  header_padding := 10;
  bottom_height := 100;
  left_width := 500;

  arena_x := left_width;
  arena_y := header_height;
  arena_width := window_width - left_width;
  arena_height := window_height - header_height - bottom_height;
  bottom_y := arena_y + arena_height;

  background_color := Color.{r = 248, g = 248, b = 245, a = 255};
  border_color := Color.{r = 0, g = 0, b = 0, a = 255};
  text_color := Color.{r = 0, g = 0, b = 0, a = 255};
  button_color := Color.{r = 50, g = 205, b = 50, a = 255};

  grid_columns := 12;
  grid_rows := 9;

  title := "BitBrawler";
  title_font_size := 30;
  title_x := header_padding;
  title_y := (header_height - title_font_size) / 2;

  InitWindow(window_width, window_height, "BitBrawler");
  SetTargetFPS(60);

  control_font_size := 20;
  control_gap := 16;
  control_count := 4;
  play_label := "Play";
  pause_label := "Pause";
  restart_label := "Restart";
  speed_label := "1x Speed";

  play_text_width := MeasureText(play_label, control_font_size);
  pause_text_width := MeasureText(pause_label, control_font_size);
  restart_text_width := MeasureText(restart_label, control_font_size);
  speed_text_width := MeasureText(speed_label, control_font_size);

  controls_width := play_text_width + pause_text_width + restart_text_width + speed_text_width + control_gap * (control_count - 1);

  controls_x := (window_width - controls_width) / 2;
  controls_y := (header_height - control_font_size) / 2;

  play_x := controls_x;
  pause_x := play_x + play_text_width + control_gap;
  restart_x := pause_x + pause_text_width + control_gap;
  speed_x := restart_x + restart_text_width + control_gap;

  recompile_label := "Recompile";
  recompile_font_size := 20;
  recompile_text_width := MeasureText(recompile_label, recompile_font_size);

  button_padding_x := 15;
  button_height := 30;
  // Button Width=Text Width+(Left Padding+Right Padding)
  button_width := recompile_text_width + button_padding_x * 2;
  button_x := window_width - header_padding - button_width;
  button_y := (header_height - button_height) / 2;
  button_text_x := button_x + (button_width - recompile_text_width) / 2;
  button_text_y := button_y + (button_height - recompile_font_size) / 2;

  // body_font_size := 18;

  while !WindowShouldClose() {
    BeginDrawing();
    ClearBackground(background_color);

    // header
    // title
    DrawText(title, title_x, title_y, title_font_size, text_color);

    // controls
    DrawText(play_label, play_x, controls_y, control_font_size, text_color);
    DrawText(pause_label, pause_x, controls_y, control_font_size, text_color);
    DrawText(restart_label, restart_x, controls_y, control_font_size, text_color);
    DrawText(speed_label, speed_x, controls_y, control_font_size, text_color);

    // recompile
    DrawRectangle(button_x, button_y, button_width, button_height, button_color);
    DrawRectangleLines(button_x, button_y, button_width, button_height, border_color);
    DrawText(recompile_label, button_text_x, button_text_y, recompile_font_size, text_color);


    // editor
    DrawRectangleLines(0, header_height, left_width, arena_height, border_color);

    // arena
    DrawRectangleLines(arena_x, arena_y, arena_width, arena_height, border_color);

    // arena grid
    for column := 1..grid_columns {
      line_x := arena_x + arena_width * column / grid_columns;
      DrawLine(line_x, arena_y, line_x, arena_y + arena_height, border_color)
    };

    for row := 1..grid_rows {
      line_y := arena_y + arena_height * row / grid_rows;
      DrawLine(arena_x, line_y, arena_x + arena_width, line_y, border_color)
    };

    // bot status
    DrawRectangleLines(0, bottom_y, left_width, bottom_height, border_color);

    // logs
    DrawRectangleLines(arena_x, bottom_y, arena_width, bottom_height, border_color);

    EndDrawing()
  };

  CloseWindow();
  return 0
};
